#!/bin/sh
# Warn, never block, when a commit changes code that the feature map in docs/ai/codemap describes.
# Enabled per clone with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0
[ -f scripts/codemap.py ] || exit 0
PYTHONDONTWRITEBYTECODE=1 python3 scripts/codemap.py hook pre-commit || true
exit 0
